# ──────────────────────────────────────────
# Dependencies — KABHI PUSH MAT KARNA 
# ──────────────────────────────────────────
node_modules/
**/node_modules/

# ──────────────────────────────────────────
# Environment Variables — SECRETS HAI 
# ──────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.*

# ──────────────────────────────────────────
# Build Output (Frontend)
# ──────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/

# ──────────────────────────────────────────
# Uploads (User/Admin uploaded files)
# ──────────────────────────────────────────
backend/uploads/
uploads/

# ──────────────────────────────────────────
# Logs
# ──────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────
